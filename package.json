{
  "name": "socrates-video-pro",
  "version": "1.2.0",
  "description": "A local video editing studio for the web, Windows, Linux, and macOS",
  "author": "NotThatRandomGuy",
  "license": "MIT",
  "private": true,
  "main": "desktop/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/NotThatRandomGuy/socrates-video-pro.git"
  },
  "scripts": {
    "start": "electron .",
    "serve": "node scripts/serve.mjs",
    "check": "node scripts/check.mjs",
    "test": "node scripts/test.mjs",
    "build:web": "node scripts/build-web.mjs",
    "build:win": "electron-builder --win nsis portable --x64 --publish never",
    "build:linux": "electron-builder --linux AppImage deb --x64 --publish never",
    "build:win:signed": "node scripts/build-signed.cjs",
    "build:mac": "electron-builder --mac dmg --publish never"
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "11.0.1"
  },
  "devDependencies": {
    "electron": "44.10.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "io.github.notthatrandomguy.socrates-video-pro",
    "productName": "Socrates Video Pro",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "css/**/*",
      "js/**/*",
      "assets/**/*",
      "desktop/**/*",
      "LICENSE",
      "package.json",
      "CHANGELOG.md"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Socrates-Video-Pro-${version}-Setup-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Socrates-Video-Pro-${version}-Portable-${arch}.${ext}"
    },
    "appImage": {
      "executableArgs": []
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo;Video;AudioVideoEditing",
      "icon": "assets/icon.png",
      "executableName": "socrates-video-pro",
      "maintainer": "NotThatRandomGuy <noreply@users.noreply.github.com>",
      "artifactName": "Socrates-Video-Pro-${version}-Linux-${arch}.${ext}",
      "syncDesktopName": true
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2 | libasound2t64",
        "libgbm1"
      ]
    },
    "mac": {
      "category": "public.app-category.video",
      "target": [
        "dmg"
      ],
      "minimumSystemVersion": "13.0",
      "icon": "assets/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Socrates-Video-Pro-${version}-macOS-${arch}.${ext}",
      "extendInfo": {
        "NSCameraUsageDescription": "Use the camera when you choose Webcam recording.",
        "NSMicrophoneUsageDescription": "Use the microphone for voice-over, webcam, or screen recording.",
        "NSAudioCaptureUsageDescription": "Include system audio when you choose screen recording."
      }
    }
  },
  "desktopName": "socrates-video-pro.desktop"
}
